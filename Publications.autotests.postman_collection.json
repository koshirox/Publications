  "item": [
    {
      "name": "01. Вход администратора",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"runId\", Date.now().toString());",
              "[\"adminToken\", \"authorToken\", \"readerToken\", \"authorId\", \"readerId\", \"categoryId\", \"postId\", \"commentId\"].forEach(function (name) {",
              "    pm.collectionVariables.unset(name);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Код ответа 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    const data = pm.response.json();",
              "    pm.test(\"Данные ответа верны\", function () {",
              "        pm.expect(data.access_token).to.be.a(\"string\").and.not.empty;",
              "    });",
              "    pm.collectionVariables.set(\"adminToken\", data.access_token);",
              "}",
              "",
              "if (pm.response.code !== 200) {",
              "    pm.execution.setNextRequest(null);",
              "}"
            ]
          }
        }
      ]
    },
