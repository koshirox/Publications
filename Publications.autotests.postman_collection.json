      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "authorToken",
      "value": ""
    },
    {
      "key": "readerToken",
      "value": ""
    },
    {
      "key": "authorId",
      "value": ""
    },
    {
      "key": "readerId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
